# Kopirajte ovaj fajl u .env i prilagodite vrijednosti.
# .env se NE postavlja na GitHub (u release ide kao .env-tajne.zip).

ASPNETCORE_ENVIRONMENT=Development

# Baza (naziv baze = broj indeksa bez prefiksa IB)
DB_HOST=sqlserver
DB_PORT=1433
DB_NAME=150237
DB_USER=sa
SQL_SA_PASSWORD=YourStrong_Passw0rd

# JWT
JWT_KEY=promijeni-ovo-u-dugacak-random-string-od-minimalno-32-znaka
JWT_ISSUER=eBook
JWT_AUDIENCE=eBookClients

# CORS (zarezom odvojeni origini)
CORS_ALLOWED_ORIGINS=http://localhost,http://10.0.2.2

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=ebook
RABBITMQ_PASSWORD=ebook_rabbit_pass

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_SENDER=ebook@example.com

# Stripe (test mod)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
